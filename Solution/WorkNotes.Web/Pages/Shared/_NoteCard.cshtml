@model WorkNotes.Business.Models.NoteSummary
@using WorkNotes.Business.Models
@using WorkNotes.Web.Notes
@{
    var title = Model.Title ?? L["Notes_Untitled"].Value;
}
@* A saved note; the board already names the context, so the card does not. The Open link (/?note={id}) and double-click open the editor over the board (openNoteEditor in notes-board.js). *@
<li class="note-cell">
    <article class="note-card @NoteCardStyle.TypeClass(Model.NoteType) @NoteCardStyle.TiltClass(Model.Id)" data-note-id="@Model.Id" aria-labelledby="note-@Model.Id-title">
        <p class="note-card__meta">
            <span>@(Model.NoteType == NoteTypes.Article ? L["NoteType_Article"] : L["NoteType_Journal"])</span>
            <time datetime="@NoteDates.Iso(Model.CreatedAtUtc)">@NoteDates.Card(Model.CreatedAtUtc)</time>
        </p>
        <h3 class="note-card__title @(Model.Title is null ? "note-card__title--untitled" : null)" id="note-@Model.Id-title">@title</h3>
        <div class="note-card__footer">
            <span>@(Model.Visibility == NoteVisibilities.Context ? L["NoteVisibility_Context"] : L["NoteVisibility_Private"])</span>
            <a class="note-card__open" asp-page="/Index" asp-route-note="@Model.Id" data-note-open aria-label="@L["Notes_OpenNamed", title]" title="@L["Notes_OpenNamed", title]">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 4.5h5.5V10M19.5 4.5 11 13M17 14v5.5H4.5V7H10" /></svg>
            </a>
        </div>
    </article>
</li>
