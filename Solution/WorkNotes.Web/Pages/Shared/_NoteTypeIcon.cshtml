@model string
@using WorkNotes.Business.Models
@* The icon of a note type (decorative): a calendar for a journal, a sheet for an article. Used by the type switches of
   the new-note card and of the editor. *@
@if (Model == NoteTypes.Article)
{
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3.5h7l4 4v13H7z" /><path d="M14 3.5v4h4M10 12h5M10 15.5h5" /></svg>
}
else
{
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5.5" width="16" height="14" rx="2" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4M8 14h3" /></svg>
}
