@page "/admin/login"
@model WorkNotes.Web.Pages.Admin.LoginModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = L["Admin_LoginTitle"]; }
<section class="account-card postit-panel">
<h1>@L["Admin_LoginTitle"]</h1>
<form method="post" data-validate>
<div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="field"><label asp-for="Input.UserName"></label><input asp-for="Input.UserName" autocomplete="username" /></div>
<div class="field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="current-password" /></div>
<button type="submit" class="btn btn-primary">@L["Button_Login"]</button>
</form>
</section>
