@page "/Notes/{id:int}"
@model WorkNotes.Web.Pages.Notes.EditModel
@using WorkNotes.Business.Models
@{
    var note = Model.Note;
    var title = note.Title ?? L["Notes_Untitled"].Value;
    ViewData["Title"] = title;
    var typeClass = note.NoteType == NoteTypes.Article ? "note-sheet--article" : "note-sheet--journal";
    // Texts the editor shows; JavaScript reads them instead of carrying its own translations.
    var phrases = new Dictionary<string, string>
    {
        ["Find"] = L["Editor_Phrase_Find"], ["Replace"] = L["Editor_Phrase_Replace"], ["next"] = L["Editor_Phrase_Next"],
        ["previous"] = L["Editor_Phrase_Previous"], ["all"] = L["Editor_Phrase_All"], ["match case"] = L["Editor_Phrase_MatchCase"],
        ["by word"] = L["Editor_Phrase_ByWord"], ["regexp"] = L["Editor_Phrase_Regexp"], ["replace"] = L["Editor_Phrase_ReplaceOne"],
        ["replace all"] = L["Editor_Phrase_ReplaceAll"], ["close"] = L["Editor_Phrase_Close"], ["current match"] = L["Editor_Phrase_CurrentMatch"],
        ["replaced $ matches"] = L["Editor_Phrase_ReplacedMatches"], ["replaced match on line $"] = L["Editor_Phrase_ReplacedOnLine"],
        ["on line"] = L["Editor_Phrase_OnLine"], ["Go to line"] = L["Editor_Phrase_GoToLine"], ["go"] = L["Editor_Phrase_Go"]
    };
    var editorData = new
    {
        version = note.Version,
        readOnly = !note.IsOwner,
        saveUrl = Url.Page("/Notes/Edit", "Save", new { id = note.Id }),
        blocks = note.Blocks.Select(block => new { id = block.Id, content = block.Content }),
        texts = new
        {
            placeholder = L["Editor_Placeholder"].Value, saved = L["Editor_StatusSaved"].Value, unsaved = L["Editor_StatusUnsaved"].Value,
            saving = L["Editor_StatusSaving"].Value, failed = L["Editor_StatusError"].Value, content = L["Field_Content"].Value
        },
        phrases
    };
}
<section class="note-editor-page" aria-labelledby="note-title">
    <div class="note-editor-toolbar">
        <a class="btn btn-ghost" asp-page="/Index" asp-route-context="@note.ContextId"><span aria-hidden="true">←</span> @L["Button_BackToBoard"]</a>
        <p class="note-editor-toolbar__meta">
            <span>@(note.NoteType == NoteTypes.Article ? L["NoteType_Article"] : L["NoteType_Journal"])</span>
            <span>@note.ContextName</span>
            <span>@(note.Visibility == NoteVisibilities.Context ? L["NoteVisibility_Context"] : L["NoteVisibility_Private"])</span>
        </p>
        <p class="note-editor-toolbar__status" role="status" aria-live="polite" data-editor-status></p>
        @if (note.IsOwner)
        {
            <button type="button" class="btn btn-primary" data-editor-save disabled>@L["Button_Save"]</button>
        }
    </div>
    <article class="note-sheet postit-panel @typeClass">
        @if (note.IsOwner)
        {
            <h1 id="note-title" class="visually-hidden">@title</h1>
            <label class="visually-hidden" for="note-title-input">@L["Field_Title"]</label>
            <input id="note-title-input" class="note-sheet__title" value="@note.Title" placeholder="@L["Notes_TitlePlaceholder"]" maxlength="@NoteRules.TitleMaxLength" autocomplete="off" data-editor-title />
            <p class="help-text">@L["Editor_Help"]</p>
        }
        else
        {
            <h1 id="note-title" class="note-sheet__title">@title</h1>
            <p class="help-text">@L["Editor_ReadOnly"]</p>
        }
        @Html.AntiForgeryToken()
        <div class="note-sheet__editor" data-note-editor></div>
        <noscript>
            <p class="field-error">@L["Editor_NoScript"]</p>
            @foreach (var block in note.Blocks)
            {
                <p class="note-sheet__paragraph">@block.Content</p>
            }
        </noscript>
    </article>
</section>
<script type="application/json" id="note-editor-data">@Json.Serialize(editorData)</script>
@section Scripts {
    <script type="module" src="~/js/note-editor.js" asp-append-version="true"></script>
}
