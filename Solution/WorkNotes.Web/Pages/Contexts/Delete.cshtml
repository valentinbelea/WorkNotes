@page "{id:int}"
@model WorkNotes.Web.Pages.Contexts.DeleteModel
@{ ViewData["Title"] = L["Contexts_DeleteTitle"]; }
<section class="account-card postit-panel">
    <h1>@L["Contexts_DeleteTitle"]</h1>
    <p>@L["Contexts_DeleteConfirm", Model.Name]</p>
    <form method="post" class="actions">
        <button type="submit" class="btn btn-danger">@L["Button_Delete"]</button>
        <a class="btn btn-secondary" asp-page="Index">@L["Button_Cancel"]</a>
    </form>
</section>
