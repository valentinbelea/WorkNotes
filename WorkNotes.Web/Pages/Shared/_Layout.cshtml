@using System.Security.Claims
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — WorkNotes</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index">WorkNotes</a>
        <nav aria-label="@L["Navigation_Account"]">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <span>@User.FindFirstValue(ClaimTypes.GivenName) @User.FindFirstValue(ClaimTypes.Surname)</span>
            <a asp-page="/Account/Index">@L["Navigation_MyAccount"]</a>
            <a asp-page="/Account/ChangePassword">@L["Navigation_ChangePassword"]</a>
            <form method="post" asp-page="/Account/Logout"><button type="submit" class="link-button">@L["Navigation_Logout"]</button></form>
        }
        else
        {
            <a asp-page="/Account/Register">@L["Navigation_Register"]</a>
            <a asp-page="/Account/Login">@L["Navigation_Login"]</a>
        }
        </nav>
        <partial name="_LanguageSelector" />
    </header>

    <main class="site-main">
        @if (TempData["StatusMessage"] is string message)
        {
            <p class="status-message" role="status">@L[message]</p>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span>WorkNotes</span>
        @await Component.InvokeAsync("ApplicationVersion")
    </footer>
    <script src="~/js/validation.js" asp-append-version="true" defer></script>
    <script src="~/js/language.js" asp-append-version="true" defer></script>
</body>
</html>
