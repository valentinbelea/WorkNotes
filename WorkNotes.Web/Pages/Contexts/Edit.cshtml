@page "{id:int?}"
@model WorkNotes.Web.Pages.Contexts.EditModel
@{
    var title = Model.IsNew ? L["Button_NewContext"] : L["Contexts_EditTitle"];
    ViewData["Title"] = title;
}
<section class="account-card postit-panel">
    <h1>@title</h1>
    <form method="post" data-validate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="field"><label asp-for="Input.Name"></label><input asp-for="Input.Name" autocomplete="off" /><span asp-validation-for="Input.Name" class="field-error"></span></div>
        <div class="field"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" rows="5"></textarea><span asp-validation-for="Input.Description" class="field-error"></span></div>
        <div class="actions">
            <button type="submit" class="btn btn-primary">@L["Button_Save"]</button>
            <a class="btn btn-secondary" asp-page="Index">@L["Button_Cancel"]</a>
        </div>
    </form>
</section>
